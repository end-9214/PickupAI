# Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS

# Django Backend Security Settings
DJANGO_SECRET_KEY=your-django-secret-key-generate-one
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_SERVER_IP,*

# Strong Backend Bearer Auth Token for Android App & Agent Authentication
AGENT_AUTH_TOKEN=your_secure_random_hex_token_here

# Server IP & API Endpoints
SERVER_PUBLIC_IP=YOUR_SERVER_PUBLIC_IP
DJANGO_API_BASE=http://YOUR_SERVER_PUBLIC_IP:8000/api

# LiveKit Cloud Credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Ollama / Local Fast LLM
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b
XTTS_SPEAKER_WAV=voice/reference_sample.wav
LANGUAGE=hi
